{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-pr-size.sh",
            "if": "Bash(git commit *)"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-pr-size.sh",
            "if": "Bash(git push *)"
          }
        ]
      }
    ]
  }
}
